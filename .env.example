# Postgres connection string (see prisma/schema.prisma, prisma.config.ts).
# Sessions persist here; if unreachable, the engine falls back to an
# in-memory store instead of failing (see src/lib/engine/session.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/dungeon_crawl"

# Claude API key for the LLM narrator/intent-parser (src/lib/llm/).
# If unset, falls back to a keyword parser and template narration instead
# of failing.
ANTHROPIC_API_KEY=""
